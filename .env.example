# ==============================================================================
# DeployForge Environment Configuration Template
# NOTE: No production credentials or secrets should be committed to source code.
# ==============================================================================

# Django Backend Configuration
DEPLOYFORGE_SECRET_KEY=generate-a-strong-random-key-in-production-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL in staging/production:
# DATABASE_URL=postgres://deployforge_user:password@localhost:5432/deployforge_db

# CI/CD Engine - Jenkins Integration
JENKINS_URL=http://localhost:8080
JENKINS_USER=deployforge-agent
JENKINS_TOKEN=your-jenkins-api-token-or-crumb

# Container Runtime Adapter ('podman' or 'docker')
CONTAINER_RUNTIME=podman

# Staging Environment Verification Endpoint
STAGING_HEALTH_URL=http://localhost:8085/health
STAGING_PORT=8085

# Security Scanner Policy Paths
SEMGREP_RULES_PATH=security_policies/semgrep-rules.yml
TRIVY_CONFIG_PATH=security_policies/trivy-config.yaml

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
