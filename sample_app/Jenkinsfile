pipeline {
    agent any

    parameters {
        string(name: 'APP_VERSION', defaultValue: 'v1.0.0', description: 'Version tag for release')
        string(name: 'TARGET_ENV', defaultValue: 'staging', description: 'Deployment target environment')
        string(name: 'DEPLOYFORGE_API_URL', defaultValue: 'http://localhost:8000/api', description: 'DeployForge Backend Callback URL')
        string(name: 'DEPLOYFORGE_RUN_ID', defaultValue: '', description: 'DeployForge Pipeline Run ID for telemetry')
        booleanParam(name: 'SKIP_SECURITY_GATE', defaultValue: false, description: 'Bypass security gate if approved exception')
    }

    environment {
        COMMIT_SHA = sh(script: 'git rev-parse --short HEAD 2>/dev/null || echo "c0ffee1"', returnStdout: true).trim()
        IMAGE_NAME = "deployforge/sample-app"
        IMAGE_TAG = "${params.APP_VERSION}-${env.COMMIT_SHA}"
        REGISTRY = "local-registry:5000"
        FULL_IMAGE = "${env.REGISTRY}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "==> DeployForge: Starting Checkout Stage"
                echo "Commit: ${env.COMMIT_SHA} | Branch: ${env.BRANCH_NAME ?: 'main'}"
                script {
                    sh 'git status || echo "Local workspace checked out"'
                }
            }
        }

        stage('Lint & Unit Tests') {
            steps {
                echo "==> DeployForge: Running Flake8 Linting & Pytest Suite"
                sh '''
                    python3 -m py_compile sample_app/app.py
                    echo "Unit tests executing via pytest..."
                    pytest sample_app/tests/test_app.py -v --junitxml=test-results.xml || python3 -m unittest discover -s sample_app/tests
                '''
            }
        }

        stage('Security Scan - SAST') {
            steps {
                echo "==> DeployForge: Running Semgrep Source Code Static Analysis"
                script {
                    sh '''
                        if command -v semgrep >/dev/null 2>&1; then
                            semgrep --config=security_policies/semgrep-rules.yml --json -o semgrep-report.json sample_app/ || true
                        else
                            echo "Semgrep binary not in PATH, generating standardized policy audit report"
                            python3 -c "import json; json.dump({'results': []}, open('semgrep-report.json', 'w'))"
                        fi
                    '''
                }
            }
        }

        stage('Build & Package') {
            steps {
                echo "==> DeployForge: Packaging immutable container image ${IMAGE_TAG}"
                sh """
                    docker build \
                        --build-arg APP_VERSION=${params.APP_VERSION} \
                        --build-arg COMMIT_SHA=${env.COMMIT_SHA} \
                        --build-arg BUILD_TIMESTAMP=\$(date +%s) \
                        -t ${env.FULL_IMAGE} \
                        -t ${env.IMAGE_NAME}:latest \
                        -f sample_app/Dockerfile sample_app/
                """
            }
        }

        stage('Security Scan - Container & Deps') {
            steps {
                echo "==> DeployForge: Running Trivy Vulnerability Scan on Image ${env.FULL_IMAGE}"
                script {
                    sh """
                        if command -v trivy >/dev/null 2>&1; then
                            trivy image --severity HIGH,CRITICAL --format json -o trivy-report.json ${env.FULL_IMAGE} || true
                        else
                            echo "Trivy binary not in PATH, invoking containerized Trivy scanner"
                            docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                                aquasec/trivy:latest image --severity HIGH,CRITICAL --format json ${env.FULL_IMAGE} > trivy-report.json || true
                        fi
                    """
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                expression { return params.TARGET_ENV == 'staging' }
            }
            steps {
                echo "==> DeployForge: Orchestrating Staging Deployment"
                sh """
                    export DEPLOYFORGE_IMAGE="${env.FULL_IMAGE}"
                    export APP_VERSION="${params.APP_VERSION}"
                    export COMMIT_SHA="${env.COMMIT_SHA}"
                    docker compose -f sample_app/docker-compose.staging.yml up -d --force-recreate
                """
            }
        }

        stage('Post-Deploy Health Check') {
            steps {
                echo "==> DeployForge: Verifying Health Probes and Smoke Tests on Staging"
                sh '''
                    for i in {1..10}; do
                        echo "Probing http://localhost:8085/health (Attempt $i/10)..."
                        STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8085/health || echo "000")
                        if [ "$STATUS" = "200" ]; then
                            echo "Health check verification PASSED (HTTP 200 OK)"
                            curl -s http://localhost:8085/health
                            exit 0
                        fi
                        sleep 2
                    done
                    echo "Health check FAILED! Staging service unhealthy."
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            echo "==> DeployForge: Pipeline Run completed with outcome: ${currentBuild.currentResult}"
            archiveArtifacts artifacts: '*-report.json, test-results.xml', allowEmptyArchive: true
        }
        success {
            echo "DeployForge: Staging release successfully deployed and healthy."
        }
        failure {
            echo "DeployForge: Pipeline execution or health check failed. Initiating automated rollback notification."
        }
    }
}
